---
import Base from '../layouts/Base.astro';
const PRICE_USD = 2.99;
const usdPrice = `$${PRICE_USD.toFixed(2)}`;
---
<Base title="Chime — SMS, categorized on-device">

<style>
  /* ---------- HERO ---------- */
  header.hero{
    padding:88px 0 64px;
    border-bottom:1px solid var(--outline-variant);
  }
  .hero .wrap{
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:56px;
    align-items:center;
  }
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-size:12px;
    font-weight:600;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--ink-60);
    background:var(--container);
    padding:6px 14px;
    border-radius:var(--r-xl);
    margin-bottom:22px;
  }
  .eyebrow .dot{
    width:6px; height:6px; border-radius:50%;
    background:var(--ink);
  }
  h1{
    font-size:clamp(38px, 4.6vw, 58px);
    line-height:1.04;
    font-weight:600;
    margin-bottom:22px;
  }
  .hero p.lede{
    font-size:17px;
    line-height:1.6;
    color:var(--ink-60);
    max-width:44ch;
    margin-bottom:34px;
  }
  .hero-ctas{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
  }
  .hero-note{
    margin-top:18px;
    font-size:13px;
    color:var(--ink-45);
  }
  /* ---------- PHONE MOCK ---------- */
  .phone{
    width:290px;
    margin:0 auto;
    background:var(--bg);
    border:1px solid var(--outline-variant);
    border-radius:36px;
    padding:14px;
    box-shadow:0 24px 60px -20px var(--ink-15);
  }
  .phone-screen{
    background:var(--surface);
    border-radius:24px;
    overflow:hidden;
  }
  .phone-search{
    margin:14px;
    height:44px;
    border-radius:var(--r-xl);
    background:var(--container);
    display:flex;
    align-items:center;
    padding:0 16px;
    gap:10px;
    font-size:13px;
    color:var(--ink-45);
  }
  .phone-search .app-mark{
    width:14px; height:14px;
    border-radius:4px;
    background:var(--ink-45);
    flex-shrink:0;
  }
  .chip-row{
    display:flex;
    gap:8px;
    padding:0 14px 14px;
    overflow:hidden;
  }
  .chip{
    font-size:11.5px;
    font-weight:600;
    padding:7px 13px;
    border-radius:var(--r-xl);
    background:var(--container);
    color:var(--ink-60);
    white-space:nowrap;
  }
  .chip.active{
    background:var(--ink);
    color:var(--bg);
  }
  .msg-list{
    padding:0 14px 18px;
    display:flex;
    flex-direction:column;
    gap:2px;
  }
  .msg-row{
    display:flex;
    gap:11px;
    align-items:flex-start;
    padding:11px 6px;
    border-radius:var(--r-md);
  }
  .avatar{
    width:36px; height:36px;
    border-radius:50%;
    background:var(--container-high);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13px;
    font-weight:600;
    color:var(--ink-80);
    flex-shrink:0;
  }
  .msg-body{flex:1; min-width:0;}
  .msg-top{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:8px;
  }
  .msg-name{
    font-size:13.5px;
    font-weight:600;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .msg-time{
    font-size:11px;
    color:var(--ink-45);
    flex-shrink:0;
  }
  .msg-snippet{
    font-size:12.5px;
    color:var(--ink-60);
    margin-top:2px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .unread .msg-name{font-weight:700;}
  .unread .msg-snippet{color:var(--ink-80);}
  .unread-dot{
    width:8px; height:8px;
    border-radius:50%;
    background:var(--ink);
    flex-shrink:0;
    margin-top:5px;
  }
  /* ---------- SECTIONS ---------- */
  section{
    padding:80px 0;
    border-bottom:1px solid var(--outline-variant);
  }
  .section-head{
    max-width:52ch;
    margin-bottom:48px;
  }
  .section-label{
    font-size:12px;
    font-weight:700;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--ink-45);
    margin-bottom:14px;
  }
  h2{
    font-size:clamp(26px, 3vw, 34px);
    font-weight:600;
    line-height:1.15;
  }
  .section-head p{
    margin-top:14px;
    font-size:15.5px;
    line-height:1.65;
    color:var(--ink-60);
  }
  .feature-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:1px;
    background:var(--outline-variant);
    border:1px solid var(--outline-variant);
    border-radius:var(--r-xl);
    overflow:hidden;
  }
  .feature{
    background:var(--bg);
    padding:30px 26px;
  }
  .feature-index{
    font-family:'Space Grotesk', sans-serif;
    font-size:12px;
    color:var(--ink-30);
    margin-bottom:16px;
  }
  .feature h3{
    font-size:16px;
    font-weight:600;
    margin-bottom:8px;
  }
  .feature p{
    font-size:13.5px;
    line-height:1.6;
    color:var(--ink-60);
  }
  /* ---------- SCREENSHOTS ---------- */
  .screenshot-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:16px;
  }
  .screenshot-cell{
    border-radius:var(--r-lg);
    overflow:hidden;
    border:1px solid var(--outline-variant);
    background:var(--surface);
  }
  .screenshot-cell img{
    width:100%;
    display:block;
    cursor:pointer;
    transition:opacity 160ms ease;
  }
  .screenshot-cell img:hover{opacity:0.85;}
  /* ---------- LIGHTBOX ---------- */
  .lightbox{
    position:fixed;
    inset:0;
    z-index:100;
    background:rgba(0,0,0,0.92);
    display:flex;
    align-items:center;
    justify-content:center;
    opacity:0;
    pointer-events:none;
    transition:opacity 200ms ease;
  }
  .lightbox.open{opacity:1; pointer-events:auto;}
  .lightbox img{
    max-width:90vw;
    max-height:90vh;
    object-fit:contain;
    border-radius:8px;
    user-select:none;
  }
  .lightbox-close{
    position:absolute;
    top:20px; right:20px;
    width:40px; height:40px;
    border-radius:50%;
    border:none;
    background:rgba(255,255,255,0.15);
    color:#fff;
    font-size:20px;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:background 160ms ease;
  }
  .lightbox-close:hover{background:rgba(255,255,255,0.3);}
  .lightbox-nav{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:48px; height:48px;
    border-radius:50%;
    border:none;
    background:rgba(255,255,255,0.15);
    color:#fff;
    font-size:22px;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:background 160ms ease;
  }
  .lightbox-nav:hover{background:rgba(255,255,255,0.3);}
  .lightbox-prev{left:20px;}
  .lightbox-next{right:20px;}
  .lightbox-counter{
    position:absolute;
    bottom:20px;
    left:50%;
    transform:translateX(-50%);
    color:rgba(255,255,255,0.7);
    font-size:14px;
    font-weight:500;
  }
  /* ---------- WHAT'S NEW ---------- */
  .whats-list{
    list-style:none;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1px;
    background:var(--outline-variant);
    border:1px solid var(--outline-variant);
    border-radius:var(--r-xl);
    overflow:hidden;
  }
  .whats-list li{
    background:var(--bg);
    padding:28px 26px;
    font-size:14px;
    line-height:1.65;
    color:var(--ink-60);
  }
  .whats-tag{
    display:inline-block;
    font-size:11.5px;
    font-weight:700;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--ink-80);
    background:var(--container);
    padding:5px 12px;
    border-radius:var(--r-xl);
    margin-bottom:14px;
  }
  /* ---------- PRIVACY BAND ---------- */
  .privacy{
    background:var(--ink);
    color:var(--bg);
    border-bottom:none;
  }
  .privacy .wrap{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:56px;
    align-items:center;
  }
  .privacy .section-label{color:color-mix(in srgb, var(--bg) 50%, transparent);}
  .privacy h2{color:var(--bg);}
  .privacy p.lede{
    color:color-mix(in srgb, var(--bg) 65%, transparent);
    font-size:15.5px;
    line-height:1.65;
    margin-top:14px;
    max-width:46ch;
  }
  .privacy-list{
    display:flex;
    flex-direction:column;
    gap:0;
  }
  .privacy-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 0;
    border-bottom:1px solid color-mix(in srgb, var(--bg) 12%, transparent);
    font-size:14.5px;
  }
  .privacy-row:last-child{border-bottom:none;}
  .privacy-row .k{color:color-mix(in srgb, var(--bg) 55%, transparent);}
  .privacy-row .v{font-weight:600;}
  /* ---------- STACK ---------- */
  .stack-list{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
  }
  .stack-pill{
    font-size:13px;
    font-weight:500;
    padding:9px 16px;
    border-radius:var(--r-xl);
    background:var(--container);
    color:var(--ink-80);
  }
  /* ---------- CTA ---------- */
  .cta{
    padding:96px 0;
    text-align:center;
    border-bottom:none;
  }
  .cta h2{margin-bottom:16px;}
  .cta p{
    color:var(--ink-60);
    font-size:15.5px;
    margin-bottom:32px;
  }
  .cta .hero-ctas{justify-content:center;}
  /* ---------- PRICE ---------- */
  .price-line{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    margin-bottom:22px;
  }
  .price{
    display:block;
    font-family:'Space Grotesk', sans-serif;
    font-size:clamp(38px, 5vw, 52px);
    font-weight:600;
    letter-spacing:-0.02em;
    line-height:1;
  }
  .price-meta{
    font-size:13px;
    color:var(--ink-45);
  }
  .cta .cta-note{
    font-size:14px;
    color:var(--ink-45);
    margin-bottom:28px;
  }
  .cta .refund-note{
    font-size:13px;
    line-height:1.6;
    color:var(--ink-45);
    max-width:46ch;
    margin:0 auto 28px;
  }
  .cta .refund-note a{
    color:var(--ink-60);
    text-decoration:underline;
    text-underline-offset:2px;
    transition:color 160ms ease;
  }
  .cta .refund-note a:hover{color:var(--ink);}
  /* ---------- HERO IMAGE SLOT ---------- */
  .img-slot{
    position:relative;
    aspect-ratio:9/18.5;
    border-radius:24px;
    overflow:hidden;
    background:var(--surface);
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .img-slot img{
    width:100%;
    height:100%;
    object-fit:fill;
  }
  .img-placeholder{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    text-align:center;
    padding:24px;
  }
  .img-placeholder .icon{
    width:40px; height:40px;
    border-radius:12px;
    border:1.5px solid var(--ink-30);
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:6px;
  }
  .img-placeholder .icon::before{
    content:"";
    width:16px; height:16px;
    border-radius:3px;
    background:var(--ink-30);
  }
  .img-placeholder .title{
    font-size:13px;
    font-weight:600;
    color:var(--ink-60);
  }
  .img-placeholder .sub{
    font-size:11.5px;
    color:var(--ink-30);
  }
  @media (max-width:860px){
    .hero .wrap{grid-template-columns:1fr; gap:48px;}
    .hero .phone{order:-1;}
    .feature-grid{grid-template-columns:1fr;}
    .whats-list{grid-template-columns:1fr;}
    .privacy .wrap{grid-template-columns:1fr;}
    .screenshot-grid{grid-template-columns:repeat(2, 1fr);}
    .cta .hero-ctas{flex-direction:column; align-items:center;}
  }
  @media (max-width:480px){
    .screenshot-grid{grid-template-columns:1fr;}
    .hero-ctas{flex-direction:column;}
    .hero-ctas .btn{width:100%; justify-content:center;}
  }
</style>

<header class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow"><span class="dot"></span>Now on Google Play</div>
      <h1 class="display">Messages, sorted.<br>Nothing uploaded.</h1>
      <p class="lede">Chime is a privacy-first SMS client for Android. A model on your phone learns to sort Personal, OTP, Banking, Promos, Carrier and Spam — and it never leaves the device.</p>
      <div class="hero-ctas">
        <a href="https://play.google.com/store/apps/details?id=com.shrivatsav.chime" target="_blank" rel="noopener" class="btn btn-solid">
          <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="#00D76F" d="M3 2 21.5 10.6 14 12 3 2Z"/><path fill="#00A0FF" d="M3 2 14 12 3 22V2Z"/><path fill="#FFCE00" d="M14 12 21.5 10.6v2.8L14 12Z"/><path fill="#FF3A44" d="M3 22 14 12l7.5 1.4L3 22Z"/></svg>
          Get it on Google Play
        </a>
        <a href="#features" class="btn btn-outline">See what it does</a>
      </div>
      <p class="hero-note">{usdPrice} one-time · Android 11+ · No account · No ads · No telemetry</p>
    </div>

    <div class="phone">
      <div class="phone-screen img-slot">
        <img src="/hero.png" alt="Chime inbox screenshot">
      </div>
    </div>
  </div>
</header>

<section id="features">
  <div class="wrap">
    <div class="section-head">
      <div class="section-label">Features</div>
      <h2 class="display">Built for reading less, knowing more.</h2>
      <p>Every feature is tuned toward getting through your inbox faster — without a server in the loop.</p>
    </div>
    <div class="feature-grid">
      <div class="feature">
        <div class="feature-index">01</div>
        <h3>On-device categorization</h3>
        <p>A classifier trained on 62,457 words sorts every thread into Personal, OTP, Banking, Promos, Carrier or Spam — and retrains locally whenever you correct it.</p>
      </div>
      <div class="feature">
        <div class="feature-index">02</div>
        <h3>Message reminders</h3>
        <p>Chime spots dates and times in incoming texts — “meet tomorrow at 3pm” — and offers a one-tap reminder, from the message or straight from the notification.</p>
      </div>
      <div class="feature">
        <div class="feature-index">03</div>
        <h3>Custom categories</h3>
        <p>Build your own categories, tune each one's weight by hand, and drag the tabs into the order you actually read in.</p>
      </div>
      <div class="feature">
        <div class="feature-index">04</div>
        <h3>Smart actions</h3>
        <p>Copy an OTP straight out of a code message, or tap a number to call. Both work from the thread and from the notification.</p>
      </div>
      <div class="feature">
        <div class="feature-index">05</div>
        <h3>Scheduled messages</h3>
        <p>Queue a message for later and pick your SIM on dual-SIM phones. WorkManager sends it even if Chime isn't open.</p>
      </div>
      <div class="feature">
        <div class="feature-index">06</div>
        <h3>Instant search</h3>
        <p>An FTS4 index spans every thread, auto-focused the moment you open it.</p>
      </div>
      <div class="feature">
        <div class="feature-index">07</div>
        <h3>Swipe actions with undo</h3>
        <p>Decide what left and right swipes do per thread, then long-press to move one — a floating pill gives you four seconds to change your mind.</p>
      </div>
      <div class="feature">
        <div class="feature-index">08</div>
        <h3>Rich threads</h3>
        <p>Every MMS photo in a per-conversation gallery, rich previews for links people send you, and a draft saved for every thread you half-finished.</p>
      </div>
      <div class="feature">
        <div class="feature-index">09</div>
        <h3>Notifications you control</h3>
        <p>Mute the categories you don't care about, give each one its own sound, and let OTP messages clean themselves up on a timer you choose.</p>
      </div>
      <div class="feature">
        <div class="feature-index">10</div>
        <h3>Locked down</h3>
        <p>Block senders you never want to hear from, recover deleted conversations from Trash, and put a fingerprint or face behind the app.</p>
      </div>
      <div class="feature">
        <div class="feature-index">11</div>
        <h3>Built for big screens</h3>
        <p>Tablets and foldables get a two-pane layout — conversation list on the left, selected thread on the right. Phones stay single-pane.</p>
      </div>
      <div class="feature">
        <div class="feature-index">12</div>
        <h3>Your language, your look</h3>
        <p>35 languages with an in-app picker, AMOLED true-black alongside a hand-tuned light and dark palette, corner styles, text size, and two app icons to choose from.</p>
      </div>
    </div>
  </div>
</section>

<section id="screenshots">
  <div class="wrap">
    <div class="section-head">
      <div class="section-label">Screenshots</div>
      <h2 class="display">See it in action.</h2>
    </div>
    <div class="screenshot-grid">
      {[1,2,3,4,5,6,7,8].map(n => (
        <div class="screenshot-cell">
          <img src={`/Demo/${n}.png`} alt={`Chime screenshot ${n}`} loading="lazy">
        </div>
      ))}
    </div>
  </div>
</section>

<section id="whats-new">
  <div class="wrap">
    <div class="section-head">
      <div class="section-label">What's new</div>
      <h2 class="display">Version 0.4.1, on Play now.</h2>
      <p>The current release adds reminders and adaptive layouts, plus a round of customization and reliability work.</p>
    </div>
    <ul class="whats-list">
      <li>
        <span class="whats-tag">Reminders</span>
        <span>Chime reads dates and times out of incoming messages and offers a one-tap reminder below the message — or straight from the notification, without opening the app. Create standalone reminders in Settings, and choose to be pinged at event time, 10 minutes before, an hour before, or a custom moment.</span>
      </li>
      <li>
        <span class="whats-tag">Tablets &amp; foldables</span>
        <span>A two-pane layout puts the conversation list on the left and the selected thread on the right. Phones are unchanged.</span>
      </li>
      <li>
        <span class="whats-tag">Appearance</span>
        <span>Two launcher icons to choose from, smart-category tabs you can drag into your preferred order, and an option to keep avatars visible for pinned chats even when avatars are hidden.</span>
      </li>
      <li>
        <span class="whats-tag">Reliability</span>
        <span>Stabilized conversation-list swipe and undo actions, hardened messaging and Android compatibility, and a fix preventing sender contact cache poisoning.</span>
      </li>
    </ul>
  </div>
</section>

<section id="privacy" class="privacy">
  <div class="wrap">
    <div>
      <div class="section-label">Privacy</div>
      <h2 class="display">The model lives on your phone. That's the whole design.</h2>
      <p class="lede">Categorization, search, reminder detection and training all run locally. There's no account to create and no server that ever sees a message.</p>
    </div>
    <div class="privacy-list">
      <div class="privacy-row"><span class="k">Cloud processing</span><span class="v">None</span></div>
      <div class="privacy-row"><span class="k">Message content uploaded</span><span class="v">Never</span></div>
      <div class="privacy-row"><span class="k">Accounts required</span><span class="v">None</span></div>
      <div class="privacy-row"><span class="k">Telemetry &amp; analytics</span><span class="v">None</span></div>
      <div class="privacy-row"><span class="k">Categorization</span><span class="v">On-device</span></div>
      <div class="privacy-row"><span class="k">Model retraining</span><span class="v">On-device</span></div>
      <div class="privacy-row"><span class="k">Reminder detection</span><span class="v">On-device</span></div>
      <div class="privacy-row"><span class="k">OTP auto-cleanup</span><span class="v">On-device, on your timer</span></div>
      <div class="privacy-row"><span class="k">Crash reports</span><span class="v">Captured on-device</span></div>
    </div>
  </div>
</section>

<section id="stack">
  <div class="wrap">
    <div class="section-head">
      <div class="section-label">Under the hood</div>
      <h2 class="display">Kotlin, Compose, Material 3.</h2>
      <p>A conventional, well-supported Android stack — nothing exotic to maintain.</p>
    </div>
    <div class="stack-list">
      <span class="stack-pill">Kotlin 2.2.10</span>
      <span class="stack-pill">Jetpack Compose · BOM 2026.02.01</span>
      <span class="stack-pill">Material 3</span>
      <span class="stack-pill">Navigation Compose 2.9.8</span>
      <span class="stack-pill">SQLite + FTS4</span>
      <span class="stack-pill">DataStore Preferences</span>
      <span class="stack-pill">WorkManager 2.9.0</span>
      <span class="stack-pill">Coil 2.6.0</span>
      <span class="stack-pill">JSoup 1.18.3</span>
      <span class="stack-pill">Android Gradle Plugin 9.2.1</span>
      <span class="stack-pill">minSdk 30 · targetSdk 36</span>
    </div>
  </div>
</section>

<section id="get" class="cta">
  <div class="wrap">
    <h2 class="display">Get Chime on<br>the Google Play Store.</h2>
    <p class="price-line">
      <span class="price">{usdPrice}</span>
      <span class="price-meta">one-time purchase · no subscription</span>
    </p>
    <p class="cta-note">Requires Android 11 or later — Chime asks to become your default SMS app.</p>
