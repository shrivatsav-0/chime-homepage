<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lb-close" aria-label="Close">&times;</button>
  <button class="lightbox-nav lightbox-prev" id="lb-prev" aria-label="Previous">&#8249;</button>
  <button class="lightbox-nav lightbox-next" id="lb-next" aria-label="Next">&#8250;</button>
  <img id="lb-img" src="" alt="Screenshot preview">
  <div class="lightbox-counter" id="lb-counter"></div>
</div>

<script>
  const images = Array.from(document.querySelectorAll('.screenshot-cell img'));
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter')!;
  let current = 0;

  function show(i: number) {
    current = (i + images.length) % images.length;
    lbImg.src = images[current].getAttribute('src') || '';
    lbCounter.textContent = `${current + 1} / ${images.length}`;
  }

  images.forEach((img, i) => img.addEventListener('click', () => { show(i); lightbox.classList.add('open'); }));

  document.getElementById('lb-close')!.addEventListener('click', () => lightbox.classList.remove('open'));
  document.getElementById('lb-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(current + 1));

  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.classList.remove('open'); });
  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('open')) return;
    if (e.key === 'Escape') lightbox.classList.remove('open');
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

